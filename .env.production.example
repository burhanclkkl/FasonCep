# Copy to .env.production on the server; do not commit the real file.
# Hostname only, no scheme, port, path or wildcard.
DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

# DOMAIN aynı zamanda canonical, sitemap ve sosyal paylaşım adresinin kaynağıdır.
# Gerçek alan adını kullanın; Compose FASONCEP_PUBLIC_URL değerini otomatik üretir.
